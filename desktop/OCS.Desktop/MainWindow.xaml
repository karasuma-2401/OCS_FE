<Window x:Class="OCS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCS Desktop"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F3F0E9">
        <Border Margin="48"
                Padding="48"
                Background="#18211D"
                CornerRadius="28">
            <StackPanel MaxWidth="760"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <TextBlock Foreground="#EF9F45"
                           FontSize="13"
                           FontWeight="Bold"
                           Text="OLD CLOTHES STORE"
                           TextOptions.TextFormattingMode="Display" />
                <TextBlock Margin="0,20,0,0"
                           Foreground="#FFFDF8"
                           FontSize="48"
                           FontWeight="Bold"
                           Text="Quản lý cửa hàng và POS"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,20,0,0"
                           Foreground="#B9C5BE"
                           FontSize="18"
                           LineHeight="28"
                           Text="Ứng dụng WPF trên Windows dành cho quản lý, nhân viên kho, kiểm định và thu ngân. Các phân hệ nghiệp vụ sẽ được bổ sung theo từng use case."
                           TextWrapping="Wrap" />
                <Border Margin="0,32,0,0"
                        Padding="18"
                        BorderBrush="#3D4A43"
                        BorderThickness="1"
                        CornerRadius="14">
                    <TextBlock Foreground="#FFFDF8"
                               FontSize="15"
                               Text="WPF · C# · .NET 10"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
