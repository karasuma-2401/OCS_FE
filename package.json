{
  "name": "ocs-frontend",
  "version": "1.0.0",
  "description": "Cross-platform client for OCS - Old Clothes Store",
  "author": "OCS Team",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~57.0.28",
    "expo-constants": "~57.0.21",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "wait-on": "^9.5.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "desktop": "concurrently --kill-others --success first \"npm:web:desktop\" \"npm:electron:dev\"",
    "web:desktop": "expo start --web --port 8081",
    "electron:dev": "wait-on http://127.0.0.1:8081 && electron electron/main.cjs",
    "build:web": "expo export --platform web",
    "build:desktop": "npm run build:web && electron-builder --win --x64",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npx expo-doctor"
  },
  "private": true,
  "build": {
    "appId": "com.ocs.desktop",
    "productName": "OCS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
